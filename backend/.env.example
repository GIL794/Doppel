# DoppelAI rebuilt backend - copy to .env and fill in. Everything has a safe
# default: with nothing set you get mock payments, templated script previews,
# no AI video and no emails. Nothing is charged and nothing leaves the machine.

# Emails registered here become admins (comma-separated)
ADMIN_EMAILS=you@example.com

# Payments: "mock" (default, no real charge) or "stripe" (needs STRIPE_API_KEY and
# STRIPE_WEBHOOK_SECRET). Real charges only when you set these yourself.
PAYMENT_PROVIDER=mock
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=

# Script preview + paid-order scripts: "template" (default, free, no AI) or "gemini".
# You picked Gemini 3 Flash in the original build chat; the default id below was
# verified against Google's docs on 2026-10-29
# (https://ai.google.dev/gemini-api/docs/models/gemini-3-flash-preview).
SCRIPT_PROVIDER=template
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview

# Avatar video: "none" (default) or "fal" (needs FAL_KEY; each render costs money).
# Default endpoint verified against fal.ai's docs on 2026-10-29
# (https://fal.ai/models/veed/fabric-1.0/text/llms.txt): billed per second of
# video, $0.08/s at 480p and $0.15/s at 720p when checked.
TEASER_PROVIDER=none
# FAL_KEY=
# FAL_MODEL=veed/fabric-1.0/text
FREE_TEASERS=2

# Paid-order automation, OFF by default. When "on" AND the Gemini/fal keys above
# are set: paid order -> Gemini drafts the script -> customer approves it ->
# fal renders the video -> delivered + emailed. Each paid step runs at most once
# and is never retried automatically; the fal request id is stored right after
# submit so a restart resumes the same job instead of paying twice. Failures
# fall back to the manual admin screens, which include a reviewed render retry
# and a free reconcile for jobs stuck at the provider.
ORDER_AUTOMATION=off

# Email (password reset, script ready, delivery): SMTP_HOST, SMTP_PORT, SMTP_USER,
# SMTP_PASSWORD, SMTP_FROM. Google sign-in: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
# BACKEND_ORIGIN.
ORDER_PRICE_GBP=350
