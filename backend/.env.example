# CORS origin of the frontend dev server
FRONTEND_ORIGIN=http://localhost:3000

# Emails registered here become admins (comma-separated)
ADMIN_EMAILS=you@example.com

# Payments: "mock" (default, no real charge) or "stripe" (requires STRIPE_API_KEY;
# the Stripe integration itself is not included in this rebuild)
PAYMENT_PROVIDER=mock
# STRIPE_API_KEY=

# Teaser avatar video generation: "none" (default; teasers fail with an explicit
# explanation). Wiring a real AI video provider is future work.
TEASER_PROVIDER=none
FREE_TEASERS=2

ORDER_PRICE_GBP=350
